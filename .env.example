# Binance API Credentials
# Get from: https://www.binance.com/en/account/api-management
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Binance Testnet (optional, for testing)
# BINANCE_TESTNET_API_KEY=your_testnet_key
# BINANCE_TESTNET_API_SECRET=your_testnet_secret

# Anthropic Claude API Key
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_api_key_here

# Obsidian Vault Path (optional, defaults to config.yaml)
# OBSIDIAN_VAULT_PATH=/Users/username/Documents/Obsidian Vault

# Trading Mode (optional)
# DRY_RUN=true  # Always safe mode until explicitly disabled

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Database Path (optional)
# DATABASE_PATH=data/trades.db
